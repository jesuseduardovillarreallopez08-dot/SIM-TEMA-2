<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.eduardosystems.simulaciondamas.controller.DamasController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <VBox alignment="CENTER" spacing="10.0">
            <children>
                <Label fx:id="lblEstado" text="Partida - Turno: Jugador (Rojas)">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <Canvas fx:id="canvasTablero" height="400.0" width="400.0" onMouseClicked="#handleCanvasClick" />
                <Button fx:id="btnNuevaPartida" mnemonicParsing="false" onAction="#handleNuevaPartida" text="Nueva Partida" />
            </children>
        </VBox>

        <VBox alignment="CENTER" spacing="10.0" HBox.hgrow="ALWAYS">
            <children>
                <Label text="Historial de Partidas Guardadas">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <TableView fx:id="tablaHistorial" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                        <TableColumn fx:id="colEstado" prefWidth="100.0" text="Estado" />
                        <TableColumn fx:id="colTurno" prefWidth="100.0" text="Turno" />
                        <TableColumn fx:id="colFecha" prefWidth="150.0" text="Fecha" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </children>
</HBox>